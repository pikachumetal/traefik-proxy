# Auto detect text files and perform LF normalization
* text=auto

# Documents
*.md text diff=markdown
*.txt text diff
*.json text diff
*.yml text diff
*.yaml text diff

# Docker
Dockerfile text diff
docker-compose*.yml text diff
compose*.yml text diff
compose*.yaml text diff

# Configuration
*.env text diff
*.env.* text diff

# Exclude files from exporting
.gitattributes export-ignore
.gitignore export-ignore
